# Groq / OpenAI API Configuration for AI Chat & Recommendations
BOOKNEST_AI_API_KEY=your_groq_or_openai_api_key_here
BOOKNEST_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
BOOKNEST_AI_MODEL=openai/gpt-oss-20b

# Fallback AI model (auto-switches when primary is unavailable, or user picks manually)
# If using the same Groq account, just change the model name — same key works
BOOKNEST_AI_FALLBACK_API_KEY=your_groq_or_openai_api_key_here
BOOKNEST_AI_FALLBACK_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
BOOKNEST_AI_FALLBACK_MODEL=openai/gpt-oss-120b

# Google OAuth2 Credentials (Optional: only needed if you want Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

